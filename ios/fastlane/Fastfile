default_platform(:ios)

platform :ios do
  desc "App Store Connect にアップロード & 審査提出（ローカル最新化含む）"
  lane :release do
    # 未追跡（ios/Podfile.lock 等）があると手動の git pull が失敗するため -u で退避
    sh("cd ../.. && git stash push -u -m 'fastlane-release' || true; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    # flutter build ios + gym の二重ビルドは避け、archive + export を一度に行う
    sh("cd ../.. && flutter build ipa --export-method app-store")

    # Dir.pwd は ios/fastlane になることが多く、../build が ios/build に誤解決する。Flutter の出力はリポジトリルートの build/ios/ipa。
    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipa_candidates = Dir.glob(File.join(ipa_dir, "*.ipa"))
    UI.user_error!("IPA が見つかりません (#{ipa_dir})。flutter build ipa のログを確認してください。") if ipa_candidates.empty?
    ipa_path = ipa_candidates.max_by { |f| File.mtime(f) }

    upload_to_app_store(
      ipa: ipa_path,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      release_notes: {
        "ja" => "・大会要項をPDF・画像で保存・共有できるようになりました（要項の書式を刷新）\n・マイページに「他の人からの見え方」プレビューを追加しました\n・お問い合わせチャットを改善しました（運営が会話ごとに自動応答を切り替え可能に・返答の文脈理解と表現を改善）\n・その他、細かな不具合の修正と安定性の向上"
      }
    )
  end

  # ───────────────────────────────────────────────
  # CI（GitHub Actions）用レーン
  # ローカル用の release / beta と違い、git pull や flutter clean は行わない
  # （CI は常にクリーンなチェックアウトから始まるため）。
  # 認証は Apple ID ではなく App Store Connect API キーを使う（2要素認証を回避）。
  # 署名は証明書を取り込み、プロファイルは sigh が API キーで取得する。
  # ───────────────────────────────────────────────

  def ci_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false,
    )
  end

  # 自動署名だとアーカイブは通るが IPA 書き出しでプロファイルを解決できず失敗する
  # （"no provisioning profile mapping was provided"）。CI では sigh で App Store 用
  # プロファイルを取得し、その名前を明示して手動署名で書き出す。
  def ci_build_ipa(api_key)
    app_id = "com.sofvo.app"
    team = ENV.fetch("APPLE_TEAM_ID", "TLVKKC442B")

    get_provisioning_profile(
      api_key: api_key,
      app_identifier: app_id,
      team_id: team,
      readonly: false,
    )
    profile_name = lane_context[SharedValues::SIGH_NAME] ||
                   ENV["sigh_#{app_id}_appstore_profile-name"]
    UI.user_error!("プロビジョニングプロファイル名を取得できませんでした") if profile_name.nil?
    UI.message("使用するプロファイル: #{profile_name}")

    build_app(
      workspace: "Runner.xcworkspace",
      scheme: "Runner",
      configuration: "Release",
      export_method: "app-store",
      export_options: {
        signingStyle: "manual",
        teamID: team,
        provisioningProfiles: { app_id => profile_name },
      },
      # アーカイブは自動署名のまま（-allowProvisioningUpdates ＋ APIキー）。
      # xcargs で PROVISIONING_PROFILE_SPECIFIER を渡すと Pods の全ターゲットにも
      # 適用され、"<Pod名> does not support provisioning profiles" で失敗する。
      # また CODE_SIGN_STYLE=Manual にすると開発用証明書が選ばれて
      # App Store 用プロファイルと不一致になる。よってプロファイルの明示は
      # 上の export_options（書き出し時）だけに限定する。
      xcargs: "-allowProvisioningUpdates " \
              "-authenticationKeyPath #{ENV.fetch('ASC_KEY_PATH')} " \
              "-authenticationKeyID #{ENV.fetch('ASC_KEY_ID')} " \
              "-authenticationKeyIssuerID #{ENV.fetch('ASC_ISSUER_ID')}",
      output_directory: "../build/ios/ipa",
      clean: false,
    )
  end

  desc "CI: App Store Connect にアップロードして審査提出"
  lane :ci_release do
    api_key = ci_api_key
    ipa_path = ci_build_ipa(api_key)
    upload_to_app_store(
      api_key: api_key,
      ipa: ipa_path,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      release_notes: {
        "ja" => ENV.fetch("RELEASE_NOTES_JA", "・細かな不具合の修正と安定性の向上"),
      },
    )
  end

  desc "CI: アップロード済みのビルドを審査提出だけする（再ビルドしない）"
  # ci_release が Apple のビルド処理待ちで打ち切られたときの続き用。
  # pubspec.yaml のバージョン/ビルド番号のビルドが App Store Connect に
  # 届いている前提で、メタデータ・リリースノートを更新して審査に出す。
  lane :ci_submit do
    api_key = ci_api_key
    version = File.read(File.expand_path("../../pubspec.yaml", __dir__))[/^version:\s*(\S+)/, 1]
    UI.user_error!("pubspec.yaml から version を読めませんでした") if version.nil?
    app_version, build_number = version.split("+")
    UI.message("審査提出するビルド: #{app_version} (#{build_number})")
    upload_to_app_store(
      api_key: api_key,
      app_version: app_version,
      build_number: build_number,
      skip_binary_upload: true,
      force: true,
      skip_metadata: false,
      skip_screenshots: true,
      precheck_include_in_app_purchases: false,
      submit_for_review: true,
      automatic_release: true,
      release_notes: {
        "ja" => ENV.fetch("RELEASE_NOTES_JA", "・細かな不具合の修正と安定性の向上"),
      },
    )
  end

  desc "CI: TestFlight にアップロード（審査提出しない）"
  lane :ci_beta do
    api_key = ci_api_key
    ipa_path = ci_build_ipa(api_key)
    upload_to_testflight(
      api_key: api_key,
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
    )
  end

  desc "TestFlight にアップロード（ベータテスト用、ローカル最新化含む）"
  lane :beta do
    # 未追跡（ios/Podfile.lock 等）があると手動の git pull が失敗するため -u で退避
    sh("cd ../.. && git stash push -u -m 'fastlane-release' || true; git pull origin main --rebase; git stash pop || true")
    sh("cd ../.. && flutter clean")
    sh("cd ../.. && flutter pub get")
    sh("rm -rf Pods Podfile.lock && pod install --repo-update")
    sh("cd ../.. && flutter build ipa --export-method app-store")

    # Dir.pwd は ios/fastlane になることが多く、../build が ios/build に誤解決する。Flutter の出力はリポジトリルートの build/ios/ipa。
    ipa_dir = File.expand_path("../../build/ios/ipa", __dir__)
    ipa_candidates = Dir.glob(File.join(ipa_dir, "*.ipa"))
    UI.user_error!("IPA が見つかりません (#{ipa_dir})。flutter build ipa のログを確認してください。") if ipa_candidates.empty?
    ipa_path = ipa_candidates.max_by { |f| File.mtime(f) }

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
  end
end
